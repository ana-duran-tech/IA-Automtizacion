    {
      "parameters": {
        "jsCode": "// ============ FILTRO ANTI-BUCLE ============\n// 1) Descarta mails enviados por la propia automatizacion (asunto con [AUTO] o remitente propio)\n// 2) Valida remitente y asunto (comparacion string vs string, en minusculas)\n// 3) Deduplica por messageId usando staticData (evita reprocesar el mismo mail)\nconst j = $input.first().json;\n\n// ID - tu input viene con guion 'message-id'\nconst messageId = String(j['message-id'] || j.messageId || j.id || '');\n\n// Subject\nconst subject = String(j.subject || j.Subject || '');\nconst subjectLower = subject.toLowerCase();\n\n// Body - ya con el mensaje agrandado\nconst body = String(j.text || j.textPlain || j.html || j.body || j.snippet || '').trim();\n\n// From - ahora es objeto, no texto\nlet fromMail = '';\nlet fromName = 'Ana Duran';\nif (j.from && typeof j.from === 'object') {\n  fromMail = j.from.value?.[0]?.address || j.from.address || '';\n  fromName = j.from.text || j.from.name || fromName;\n} else {\n  fromMail = String(j.from || '');\n}\n\n// Filtros anti-bucle\nif (!messageId) { return []; }\nif (body.length < 5) { return []; }\nif (subjectLower.includes('auto') || subjectLower.includes('out of office')) { return []; }\n\nreturn [{\n  json: {\n    messageId: messageId,\n    threadId: j.threadId || '',\n    subject: subject,\n    fromMail: fromMail || 'anaduran78@gmail.com',\n    fromName: fromName,\n    body: body,\n    recibidoEn: new Date().toISOString()\n  }\n}];"
      },
      "id": "f448b5f4-bc3d-49ad-a0bf-60f47565aa52",
      "name": "Filtro Anti-Bucle",
