    {
      "parameters": {
        "jsCode": "// ============ PREPARAR CATALOGO ============\n// Normaliza la lista de articulos de Notion y fuerza NUMERO en 'unidades por caja'.\n\nfunction pick(obj, keys) {\n  for (const k of keys) {\n    if (obj[k]!== undefined && obj[k]!== null && String(obj[k]).trim()!== '') return obj[k];\n  }\n  return '';\n}\nfunction aNumero(v) {\n  const m = String(v).match(/\\d+/);\n  return m ? parseInt(m[0], 10) : 0;\n}\n\nconst catalogo = [];\nfor (const item of $('Leer Lista de Articulos (Notion)').all()) {\n  const j = item.json;\n  const nombreRaw = pick(j, ['property_art_culo', 'art_culo', 'title', 'name']);\n  const cajaRaw = pick(j, ['property_cantidad_', 'property_cantidad', 'property_', 'cantidad']);\n  const nombre = String(nombreRaw ?? '').trim();\n  if (!nombre) continue;\n  catalogo.push({\n    articulo: nombre,\n    unidadesPorCaja: aNumero(cajaRaw)\n  });\n}\n\n// ESTO ES LO QUE LE FALTABA A TU IA\nconst catalogoTexto = catalogo\n  .map(c => `- ${c.articulo}: ${c.unidadesPorCaja} unidades por caja`)\n  .join('\\n');\n\nconst pedidoItem = $('Filtro Anti-Bucle').first()?.json || $('Trigger: Leo Mails con Pedidos').first()?.json;\n\nreturn [{\n  json: {\n    pedido: pedidoItem,\n    catalogo: catalogo,\n    catalogoTexto: catalogoTexto, // ahora Tomo Decision sí lo encuentra\n    totalEnCatalogo: catalogo.length\n  }\n}];"
      },
      "id": "740df9d3-fea5-480e-abd2-049ee42d092c",
      "name": "Preparar Catalogo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1104,
        192
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"cliente\": { \"type\": \"string\", \"description\": \"Nombre del cliente detectado en el mail o el mail si no hay nombre\" },\n    \"mail\": { \"type\": \"string\", \"description\": \"Mail del cliente\" },\n    \"tipo_compra\": { \"type\": \"string\", \"enum\": [\"mayorista\", \"minorista\", \"analisis\"] },\n    \"total_articulos\": { \"type\": \"number\", \"description\": \"Suma total de unidades pedidas\" },\n    \"descripcion_compra\": { \"type\": \"string\", \"description\": \"Detalle legible del pedido: articulo, cantidad, cajas\" },\n    \"motivo\": { \"type\": \"string\", \"description\": \"Regla aplicada para la decision\" },\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"articulo\": { \"type\": \"string\" },\n          \"cantidad_solicitada\": { \"type\": \"number\" },\n          \"unidades_por_caja\": { \"type\": \"number\" },\n          \"cajas_completas\": { \"type\": \"boolean\" },\n          \"encontrado_en_catalogo\": { \"type\": \"boolean\" }\n        },\n        \"required\": [\"articulo\", \"cantidad_solicitada\", \"unidades_por_caja\", \"cajas_completas\", \"encontrado_en_catalogo\"]\n      }\n    }\n  },\n  \"required\": [\"cliente\", \"mail\", \"tipo_compra\", \"total_articulos\", \"descripcion_compra\", \"motivo\", \"items\"]\n}"
      },
      "id": "8dea0290-8199-4415-9a09-5af0d343cedc",
      "name": "Formato de Salida",
