    {
      "parameters": {
        "jsCode": "// ============ NORMALIZAR DECISION ============\n// Convierte todo a tipos correctos (numero / boolean / string) y\n// revalida las reglas de negocio de forma deterministica.\n\nconst norm = (s) => String(s ?? '')\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .toLowerCase().trim();\n\nconst aNumero = (v) => {\n  const n = typeof v === 'number' ? v : parseFloat(String(v ?? '').replace(',', '.'));\n  return Number.isFinite(n) ? n : 0;\n};\n\nconst raw = $input.first().json;\nconst d = raw.output ?? raw;\n\nconst pedido = $('Preparar Catalogo').first().json.pedido;\nconst catalogoCompleto = $('Preparar Catalogo').first().json.catalogoCompleto === true;\n\nconst items = Array.isArray(d.items) ? d.items.map((it) => ({\n  articulo: String(it.articulo ?? '').trim(),\n  cantidadSolicitada: aNumero(it.cantidad_solicitada),\n    encontrado: it.encontrado_en_catalogo === true\n})) : [];\n\nlet total = aNumero(d.total_articulos);\nif (total <= 0 && items.length) {\n  total = items.reduce((acc, it) => acc + it.cantidadSolicitada, 0);\n}\n\n\n// --- Revalidacion deterministica (numero vs numero, boolean vs boolean) ---\nconst hayEspecial = items.some((it) => norm(it.articulo).includes('articulo especial'));\n\nlet tipoRaw = String($input.first().json.output.tipo_compra ?? 'minorista').trim().toLowerCase();\nlet tipo = tipoRaw.charAt(0).toUpperCase() + tipoRaw.slice(1);\n\nconst descripcion = String(d.descripcion_compra ?? '').trim()\n  || items.map((it) => `${it.articulo}: ${it.cantidadSolicitada} u `).join(' | ')\n  || 'Sin detalle';\n\nreturn [{\n  json: {\n    cliente: String(d.cliente ?? pedido.from ?? '').trim() || pedido.from,\n    mail: String(d.mail ?? pedido.from ?? '').trim() || pedido.from,\n    tipoCompra: tipo,\n    totalArticulos: total,\n    descripcionCompra: descripcion,\n    motivo: String(d.motivo ?? '').trim(),\n    items,\n    messageId: pedido.messageId,\n    threadId: pedido.threadId,\n    asunto: pedido.subject,\n    actualizadoEn: new Date().toISOString()\n  }\n}];"
      },
